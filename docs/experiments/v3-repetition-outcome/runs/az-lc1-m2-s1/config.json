{
  "rules": "lc1-2",
  "features": "mover-relative-repetition",
  "arch": "mlp_small",
  "iterations": 200,
  "games_per_iteration": 50,
  "num_simulations": 100,
  "c_puct": 1.5,
  "dirichlet_alpha": 0.3,
  "dirichlet_epsilon": 0.25,
  "temperature_moves": 10,
  "max_moves": 1000,
  "buffer_positions": 100000,
  "train_steps": 100,
  "batch_size": 256,
  "lr": 0.02,
  "momentum": 0.9,
  "weight_decay": 0.0001,
  "augment": true,
  "checkpoint_every": 10,
  "eval_every": 10,
  "eval_pairs": 100,
  "eval_sims": 50,
  "truncation_stop_rate": 0.05,
  "truncation_stop_iterations": 3,
  "allow_missing_features": false,
  "seed": 1
}
